# Copy to .env. Every value is optional; defaults are dev-safe.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True = run tasks inline (tests/demos only; blocks the request).
CELERY_TASK_ALWAYS_EAGER=False

# Risk registry: mock by default. 
RISK_REGISTRY_MOCK=True
RISK_REGISTRY_URL=
RISK_REGISTRY_MOCK_DELAY_MIN=1
RISK_REGISTRY_MOCK_DELAY_MAX=4
RISK_REGISTRY_MOCK_FAILURE_RATE=0.3
RISK_REGISTRY_MOCK_FLAG_RATE=0.1
RISK_REGISTRY_TIMEOUT=45
RISK_MAX_ATTEMPTS=5
RISK_RETRY_BASE_SECONDS=60